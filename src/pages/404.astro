---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/content";
---

<BaseLayout title="页面未找到" description="你访问的页面不存在或已经移动。" noindex={true}>
  <div class="not-found">
    <p class="error-code">404</p>
    <h1>这里没有找到内容</h1>
    <p>页面可能已经移动，也可能从未存在。</p>
    <div class="intro-actions">
      <a class="primary-button" href={withBase("/")}>返回首页</a>
      <a class="secondary-button" href={withBase("/posts/")}>浏览文章</a>
    </div>
  </div>
</BaseLayout>
