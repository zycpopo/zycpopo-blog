---
import site from "../data/site.json";
import { withBase } from "../lib/content";

const pathname = Astro.url.pathname;
const navigation = [
  { label: "首页", href: "/" },
  { label: "文章", href: "/posts/" },
  { label: "专栏", href: "/columns/" },
  { label: "归档", href: "/archive/" },
  { label: "项目", href: "/projects/" },
  { label: "关于", href: "/about/" }
];

const active = (href: string) => {
  const target = withBase(href);
  return href === "/" ? pathname === target : pathname.startsWith(target);
};
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase("/")} aria-label={`${site.name}首页`}>
      <img class="brand-mark" src={`${withBase("/favicon.svg")}?v=2`} alt="" aria-hidden="true" width="32" height="32" />
      <span>{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={withBase(item.href)} aria-current={active(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-nav">
      <summary aria-label="打开导航">菜单</summary>
      <nav aria-label="移动端主导航">
        {navigation.map((item) => (
          <a href={withBase(item.href)} aria-current={active(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
