---
import { withBase } from "../lib/content";

interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
const pageUrl = (page: number) => page === 1 ? withBase("/posts/") : withBase(`/posts/${page}/`);
---

{total > 1 && (
  <nav class="pagination" aria-label="文章分页">
    {current > 1 ? <a href={pageUrl(current - 1)}>上一页</a> : <span aria-disabled="true">上一页</span>}
    <span>第 {current} / {total} 页</span>
    {current < total ? <a href={pageUrl(current + 1)}>下一页</a> : <span aria-disabled="true">下一页</span>}
  </nav>
)}
